<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>English</string>
  <key>CFBundleDisplayName</key>
  <string>Verve</string>
  <key>CFBundleExecutable</key>
  <string>verve</string>
  <key>CFBundleIconFile</key>
  <string>verve.icns</string>
  <key>CFBundleIdentifier</key>
  <string>com.verve.app</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Verve</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundleVersion</key>
  <string>__BUILD__</string>
  <key>CSResourcesFileMapped</key>
  <true/>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSRequiresCarbon</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright (c) 2026 Verve. All rights reserved.</string>

  <!-- Local Network Privacy (macOS 15 Sequoia / iOS 14+). Required so the app
       can connect to devices on the local network (e.g. SSH to 192.168.x.x).
       Without this key macOS silently blocks the TCP connection and surfaces it
       as ENETUNREACH / EHOSTUNREACH ("网络不可达"), even though `ssh` from the
       shell works. The string below is shown in the first-run permission prompt. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>Verve 需要访问本地网络以连接局域网内的 SSH 主机。</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_ssh._tcp</string>
    <string>_sftp-ssh._tcp</string>
  </array>

  <!-- File types Verve can open. Declaring these is what makes Verve appear in
       Finder's "Open With" / "Get Info → Open with" list and lets the user set
       it as the default app for .md and friends. cargo-bundle 0.9.0 does not
       emit CFBundleDocumentTypes from [package.metadata.bundle], so this whole
       plist is injected into the .app bundle by scripts/build.sh. -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Markdown Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Default</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>net.daringfireball.markdown</string>
        <string>public.plain-text</string>
        <string>public.html</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array>
        <string>md</string>
        <string>markdown</string>
        <string>mdown</string>
        <string>mkd</string>
        <string>mkdn</string>
        <string>txt</string>
        <string>mdx</string>
        <string>html</string>
        <string>htm</string>
      </array>
    </dict>
  </array>

  <!-- Declare the .mdx extension as a plain-text conforming type so older
       macOS releases (which do not yet know about MDX) still route .mdx files
       to Verve via the document type above. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>com.verve.mdx</string>
      <key>UTTypeDescription</key>
      <string>MDX Markdown Document</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.plain-text</string>
        <string>public.text</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>mdx</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>text/markdown</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
